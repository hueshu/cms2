{
  "name": "cf-cms-pages",
  "version": "1.0.0",
  "description": "CF-CMS Template Engine and Page Rendering System",
  "main": "src/services/templateService.ts",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "template-engine",
    "cms",
    "cloudflare",
    "workers",
    "handlebars",
    "mustache",
    "template",
    "rendering"
  ],
  "author": "HueShu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "marked": "^11.0.0"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "zod": "^3.22.0"
  },
  "exports": {
    ".": {
      "import": "./src/services/templateService.ts",
      "types": "./src/services/templateService.ts"
    },
    "./engine": {
      "import": "./src/services/templateEngine.ts",
      "types": "./src/services/templateEngine.ts"
    },
    "./templates/*": "./src/templates/*"
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}